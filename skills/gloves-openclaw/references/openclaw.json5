{
  // Install the packaged plugin on the Gateway host first:
  //   openclaw plugins add @gloves/openclaw
  plugins: {
    entries: {
      gloves: {
        enabled: true,
        config: {
          root: "~/.openclaw/secrets",
          glovesBin: "gloves",
          operatorAgentId: "main",
          timeoutMs: 10000
        }
      }
    }
  },
  agents: {
    relationships: {
      tools: {
        alsoAllow: ["gloves"]
      }
    }
  }
}
